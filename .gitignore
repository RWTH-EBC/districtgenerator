# --- Python & Build Caches ---
.venv/
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
*.egg/
*.eggs
districtgenerator.egg-info/

# --- IDEs ---
.idea/
.vscode/

# --- Project-specific data & results ---
districtgenerator/results/
districtgenerator/data/reference/weather/
errorfile.txt
# --- user inputs: own configs and scenarios stay local, only the shipped examples are tracked ---
/districtgenerator/data/inputs/configs/*
!/districtgenerator/data/inputs/configs/.env.CONFIG.EXAMPLE
!/districtgenerator/data/inputs/configs/.env.CONFIG.FREIBURG
/districtgenerator/data/inputs/scenarios/*
!/districtgenerator/data/inputs/scenarios/example_*.csv
!/districtgenerator/data/inputs/scenarios/info.txt
# project folder created by examples/e11_own_project.py when run from the repository root
/data/districtgenerator/

# --- temporary data, backup & logs ---
*.bk
*.log

# --- Solver solution files  ---
*.lp
*.sol
*.ilp
*.prm
*.mps

# --- Data Serialization (Pickles etc.) ---
*.p
*.pkl

# --- Documentation ---
docs/_build/