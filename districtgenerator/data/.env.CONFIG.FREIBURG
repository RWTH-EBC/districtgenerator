# This file contains the default paramters defined in config.py, decentral & central device config
# Compare with the example config file to see the differences, it only contains some parameters
# Note: All parameters defined in this file will override the default values in config.py


# Keep in mind you need a <scenario_name>.csv file in the data/scenarios folder
SCENARIO_NAME=example_decentral_freiburg
# Type of parallelization to use for the profile generation. Options: "threading", "multiprocessing"
PARALLELIZATION_TYPE=multiprocessing

#################################################
### General Configurations (multiple Configs) ###
#################################################

# Location and Climate Data (LocationConfig)
TIMEZONE=1
ALBEDO=0.2
TRYYEAR=TRY2045
TRYTYPE=Somm
ZIP=79100

# Time and Data Configurations (TimeConfig)
TIMERESOLUTION=3600
CLUSTERLENGTH=604800
CLUSTERNUMBER=4
DATARESOLUTION=3600
DATALENGTH=31536000

# Operational & Calendar Configuration (CalenderConfig)
CONSIDER_HEATING_PERIOD=True
HEATING_PERIOD_START=259
HEATING_PERIOD_END=135
CONSIDER_COOLING_PERIOD=True
COOLING_PERIOD_START=105
COOLING_PERIOD_END=273

# Design Building Parameters (DesignBuildingConfig)
T_SET_MIN=18.0
T_SET_MIN_NIGHT=18.0
T_SET_MIN_FREE_DAY=16.0
T_SET_MAX=26.0
T_SET_MAX_NIGHT=28.0
T_BIVALENT=-2.0
T_HEATLIMIT=15.0
VENTILATION_RATE=0.5

# EHDO Model Parameters (EhdoConfig)
ENABLE_SUPPLY_EL=True
ENABLE_FEED_IN_EL=True
ENABLE_PRICE_CAP_EL=False
PRICE_CAP_EL=60
ENABLE_CAP_LIMIT_EL=False
CAP_LIMIT_EL=100000
ENABLE_SUPPLY_LIMIT_EL=False
SUPPLY_LIMIT_EL=100000

ENABLE_SUPPLY_GAS=False
ENABLE_PRICE_CAP_GAS=False
PRICE_CAP_GAS=0.04
ENABLE_FEED_IN_GAS=False
REVENUE_FEED_IN_GAS=0.02
ENABLE_CAP_LIMIT_GAS=False
CAP_LIMIT_GAS=1000000

ENABLE_SUPPLY_BIOMASS=False
ENABLE_SUPPLY_LIMIT_BIOMASS=False
SUPPLY_LIMIT_BIOMASS=1000000

ENABLE_SUPPLY_HYDROGEN=False
ENABLE_SUPPLY_LIMIT_HYDROGEN=False
SUPPLY_LIMIT_HYDROGEN=1000000

ENABLE_SUPPLY_WASTE=False
ENABLE_SUPPLY_LIMIT_WASTE=False
SUPPLY_LIMIT_WASTE=1000000

PEAK_DEM_MET_CONV=True
CO2_TAX=0
CO2_EL_FEED_IN=0
CO2_GAS_FEED_IN=0
OPTIM_FOCUS=0
INTEREST_RATE=0.05
OBSERVATION_TIME=20
N_CLUSTERS=12


