# =============================================================================
# AUTO-GENERATED FROM districtgenerator/data_handling/config.py - DO NOT EDIT.
# Regenerate with:
#   python -m districtgenerator.data_handling.generate_env_example
# =============================================================================
#
# This file is a TEMPLATE. It lists every parameter that can be overridden,
# together with its default value from config.py. All lines are commented out,
# so loading this file changes nothing.
#
# How to override values:
#   1. Create your own file in districtgenerator/data/, e.g. .env.CONFIG.MYPROJECT
#      (a file named .env.CONFIG is ignored by git and can be used for local tests).
#   2. Copy ONLY the lines you want to change from this template into it,
#      remove the leading "# " and adjust the value.
#   3. Load it: Datahandler(env_path=".env.CONFIG.MYPROJECT")
#
# Notes:
#   - Variable names are case-insensitive.
#   - Nested parameters use "__", e.g. SOLVER_OPTIONS__TIME_LIMIT=600.
#   - Central devices use the prefix "C_", decentral devices the prefix "D_".
#   - Lists are written as [a, b, c]. A single value is used for all years.
#   - "#" directly after "=" is part of the value (hex colors), not a comment.


##############################################################################
### LocationConfig
### LocationConfig class to manage location-related parameters for the district generator.
##############################################################################

# Shift between the location's time and GMT in hours. CET would be 1.
# TIMEZONE=1

# Ground reflectance. 0 refers to 0% and 1 refers to 100%.
# ALBEDO=0.2

# Test reference year of DWD. Possible entries are TRY2015 and TRY2045.
# TRYYEAR=TRY2015

# Test reference conditions of DWD. Possible entries are Jahr, Somm, Wint.
# TRYTYPE=Jahr

# Area of the district in ha (hectare)
# DISTRICT_AREA=1.0

# Zip code of the location.
# ZIP=10115

# Consider active power cap for the district transformer. If set, it is used for BOTH import and export at the GNP.
# ENABLE_TRAFOMAX_W=False

# Active power cap for the district transformer. If set, it is used for BOTH import and export at the GNP. (Watt)
# TRAFOMAX_W=500000.0

# Consider per-building maximum import/export at the building PCC.
# ENABLE_BUILDINGMAX_W=False

# Per-building maximum import/export at the building PCC. (Watt)
# BUILDINGMAX_W=50000.0

##############################################################################
### TimeConfig
### TimeConfig class to manage time-related parameters for the district generator.
##############################################################################

# Required time resolution in seconds. Tip: 3600 refers to an hourly resolution. 900 to a 15min resolution.
# TIMERESOLUTION=3600

# Length of cluster. Tip: 604800 refers to one week. 86400 for one day.
# CLUSTERLENGTH=604800

# Number of clusters
# CLUSTERNUMBER=4

# Time resolution of input data in seconds. (If you don't change weather data, here is no need to change).
# DATARESOLUTION=3600

# Length of input data in seconds. (If you don't change weather data, here is no need to change).
# DATALENGTH=31536000

##############################################################################
### DesignBuildingConfig
### DesignBuildingConfig class to manage design parameters for all buildings in the district generator.
##############################################################################

# Required minimum indoor temperature (for heating load calculation) in degrees Celsius
# T_SET_MIN=21.0

# Required minimum indoor temperature at night (for heating load calculation) in degrees Celsius
# T_SET_MIN_NIGHT=18.0

# Minimum required indoor temperature on a non-working day in a non-residential building (for heating load calculations)
# T_SET_MIN_FREE_DAY=18.0

# Required maximum indoor temperature (for cooling load calculation) in degrees Celsius
# T_SET_MAX=24.0

# Required maximum indoor temperature at night (for cooling load calculation) in degrees Celsius
# T_SET_MAX_NIGHT=28.0

# Dual mode temperature (for heat pump design) in degrees Celsius
# T_BIVALENT=-2.0

# Limit temperature (for heat pump design)
# T_HEATLIMIT=15.0

# Room ventilation rate in 1/h (per hour)
# VENTILATION_RATE=0.5

# Thermal building model type. Possible entries are '5R1C' and '7R2C'
# THERMAL_MODEL_TYPE=7R2C

# Optional low-temperature measures replace the nominal supply and return
# temperatures used to construct the building heating curve.
# Source:
# KWW-Technikkatalog Wärmeplanung
# °C
# LOW_TEMP_MEASURES_SUPPLY_NOM=50.0

# °C
# LOW_TEMP_MEASURES_RETURN_NOM=40.0

##############################################################################
### EcoConfig
### EcoConfig class to manage economic parameters for the district generator.
##############################################################################

# General economic parameters
# Interest rate for the device operational optimization analysis. The interest rate affects the annualization of the investments according to VDI 2067.
# INTEREST_RATE=0.05

# Project lifetime, for the device operational optimization analysis. The project lifetime affects annualization of investments according to VDI 2067 in years
# OBSERVATION_TIME=20

# Optimization focus. Annual costs vs CO2 emissions. '0' means only cost optimization; '1' means only CO2 optimization.
# OPTIMIZATION_FOCUS=0

# The interpolation points can be either defined by specifying the exact years in interpolation_points or by choosing a number of interpolation points num_interpolation_points.
# *Warning: num_interpolation_points overrides interpolation_points if both are specified.
# Number of interpolation points if not None these are used, otherwise the exact position is used
# NUM_INTERPOLATION_POINTS=None

# Exact interpolation points if num_interpolation_points is None, these points are used for interpolation
# INTERPOLATION_POINTS=[0, 5, 10, 15]

# electricity prices and feed-in revenue in €/kWh
# Electricity price in €/kWh
# PRICE_SUPPLY_EL=[0.3969]

# Feed-in electricity price in €/kWh
# REVENUE_FEED_IN_EL=[0.0794]

# Electricity price for the energy hub in €/kWh
# PRICE_SUPPLY_EL_EH=[0.159]

# Feed-in electricity price for the energy hub in €/kWh
# REVENUE_FEED_IN_EL_EH=[0.0794]

# gas and other fuel prices in €/kWh
# Gas price in €/kWh
# PRICE_SUPPLY_GAS=[0.1236]

# Gas price for the energy hub in €/kWh
# PRICE_SUPPLY_GAS_EH=[0.082]

# Revenue for natural gas feed-in €/kWh
# REVENUE_FEED_IN_GAS=[0.02]

# Gasoline price in €/liter
# PRICE_GASOLINE_LITER=[1.7]

# Hydrogen price in €/kWh
# PRICE_HYDROGEN=[0.1]

# Waste price in €/kWh
# PRICE_WASTE=[0.1]

# Biomass price in €/kWh
# PRICE_BIOMASS=[0.05]

# Oil price in €/kWh
# PRICE_OIL=[0.9]

# Gross district heat price in €/kWh
# PRICE_DISTRICT_HEAT=[0.16385]

# CO2 emission factors in kg/kWh
# CO2 emissions for electricity import (grid mix) in kg/kWh
# CO2_EL_GRID=[0.363]

# CO2 emissions for burning natural gas in kg/kWh
# CO2_GAS=[0.201]

# CO2 emissions for burning biomass in kg/kWh
# CO2_BIOM=[0.35]

# CO2 emissions for burning hydrogen in kg/kWh
# CO2_HYDROGEN=[0.0402]

# CO2 emissions for burning oil in kg/kWh
# CO2_OIL=[0.31]

# CO2 emissions for burning waste in kg/kWh
# CO2_WASTE=[0.02]

# CO2 emissions for district heat in kg/kWh
# CO2_DISTRICT_HEAT=[0.2]

# Co2 tax in €/t_CO2
# CO2 tax. Tax on CO2 emissions due to burning natural gas, biomass or waste in €/t_CO2 if relevant for consumer
# CO2_TAX=[0]

