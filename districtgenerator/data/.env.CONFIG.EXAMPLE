# D_PV__KAPPA_LID=0.015

# Investment subsidy rate as a fraction of investment cost (0 to 1).
# D_PV__INV_SUBSIDY_RATE=0.0

# STC parameters (Solar Thermal Collector)
# Flow temperature in degree Celsius.
# D_STC__T_FLOW=50

# Optical efficiency (zero loss collector efficiency).
# D_STC__ZERO_LOSS=0.786

# First order loss coefficient (linear thermal losses) in Watt per squaremeter per Kelvin.
# D_STC__FIRST_ORDER=0.003345

# Second order loss coefficient (quadratic thermal losses) in Watt per squaremeter per Kelvin square.
# D_STC__SECOND_ORDER=1.42e-05

# Maximum life time in years.
# D_STC__LIFE_TIME=20

# Unsubsidized investment in €/m^2.
# D_STC__INV_BASE=600

# Operation and maintenance costs as a fraction of total investment costs (percentage).
# D_STC__COST_OM=0.05

# Investment subsidy rate as a fraction of investment cost (0 to 1).
# D_STC__INV_SUBSIDY_RATE=0.0

# TES parameters (Thermal Energy Storage)
# Minimum state of charge.
# D_TES__SOC_MIN=0.0

# Maximum state of charge.
# D_TES__SOC_MAX=1.0

# Standby hourly efficiency (accounts for self-discharge).
