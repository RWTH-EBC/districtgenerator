##############################################################################
### PyomoConfig
### PyomoConfig class to manage the configuration of the Pyomo optimization solver.
##############################################################################

# Name of the solver to be used. Options: 'gurobi', 'highs', 'cbc' etc. highs does not require any additional download or license. Already available if all packages in requirements.txt are installed.
# SOLVER_NAME=gurobi

# Path to solver executable, if needed
# SOLVER_EXECUTABLE=None

# Time limit in seconds for each optimization run
# SOLVER_OPTIONS__TIME_LIMIT=600

# Acceptable MIP gap from optimal solution
# SOLVER_OPTIONS__MIP_GAP=0.01

# Number of threads to use for solving
# SOLVER_OPTIONS__THREADS=4

# Allow non-convex problems
# SOLVER_OPTIONS__NONCONVEX=2

# Try to reduce the model size before solving 1 = yes, 0 = no -> May slightly change results
# SOLVER_OPTIONS__DUAL_REDUCTIONS=1

##############################################################################
### HeatGridConfig
### Manages the configuration for the district heating network.
##############################################################################

# Heating network generation, selected between:"3rd", "4th" and "5th"
# GENERATION=4th

# Whether consider road constraints in pipeline topology optimization, selected between:"node" and "road"
# TOPOLOGY_OPTION=node

# selected between: "constant" and "heating_curve"(controlled within limits depending on the outdoor temperature)
# TEMPERATURE_MODE=constant

# selected between: True (heuristic method) and False (optimization method)
# HEURISTIC=True

# Distance between the centerlines of the supply and return pipelines in meters.
# D_HEATING_NETWORK=1.0

# Flow temperature of the cooling network in degrees Celsius.
# T_HOT_COOLING_NETWORK=12.0

# Return temperature of the cooling network in degrees Celsius.
# T_COLD_COOLING_NETWORK=6.0

# Distance between the centerlines of supply and return pipelines in meters.
# D_COOLING_NETWORK=1.0

# Temperature difference in heat exchangers in Kelvin.
# DELTA_T_HEATTRANSFER=5.0

# Lifetime of the heating network and its components in years.
# LIFE_TIME=40

# Consideration of asphalt layer (1 = yes, 0 = no).
# ASPHALTLAYER=1

# Asphalt layer thickness in meters.
# D_ASPH=0.18

# Installation depth of the grid beneath the surface in meters.
# GRID_DEPTH=1.0

# Soil heat conductivity in W/(m*K). Source: Median value from table 4.1 Wessolek, G. (2022). Parametrisierung thermischer Bodeneigenschaften: Endbericht
# K_SOIL=1.52

# Polyurethane foam heat conductivity. Source: VDI Wärmeatlas
# K_PUF=0.03

# Polyethylene heat conductivity. Source: VDI Wärmeatlas
# K_PE=0.4

# Heat losses at the substation as a percentage (%). Source: Technikkatalog Wärmeplanung 2024
# H_LOSS_SUBST=5

# Pressure drop at the substation in Pascal (Pa). Source: Technikkatalog Wärmeplanung 2024
# DP_SUBSTATION=75000.0

# Pressure drop at the energy hub in Pascal (Pa). Source: Technikkatalog Wärmeplanung 2024
# DP_ENERGY_HUB=100000.0

# Investment costs for the substation in €/kW_th. Source: Technikkatalog Wärmeplanung 2024
# C_SUBST=584

# Operation & Maintenance (O&M) costs in €/MWh_th. Source: Technikkatalog Wärmeplanung 2024
# COST_OM_SUBST=50

# Lifetime of the substation in years. Source: Technikkatalog Wärmeplanung 2024
# LIFETIME_SUBST=25

# Annual fixed Operation & Maintenance (O&M) costs in % of the investment costs.
# C_OM=1.44

# Supply temperature of 3rd generation heat grid in degrees Celsius.
# T_HOT_HEATING_NETWORK__CONSTANT__3RD=80.0

# Supply temperature of 4th generation heat grid in degrees Celsius.
# T_HOT_HEATING_NETWORK__CONSTANT__4TH=55.0

# Supply temperature of 5th generation heat grid in degrees Celsius.
# T_HOT_HEATING_NETWORK__CONSTANT__5TH=18.0

# Supply temperature of 3rd generation heat grid when outdoor temperature is high in degrees Celsius.
# T_HOT_HEATING_NETWORK__HEATING_CURVE__MAX__3RD=75.0

# Supply temperature of 4th generation heat grid when outdoor temperature is high in degrees Celsius.
# T_HOT_HEATING_NETWORK__HEATING_CURVE__MAX__4TH=50.0

# Supply temperature of 5th generation heat grid when outdoor temperature is high in degrees Celsius.
# T_HOT_HEATING_NETWORK__HEATING_CURVE__MAX__5TH=18.0

# Supply temperature of 3rd generation heat grid when outdoor temperature is low in degrees Celsius.
# T_HOT_HEATING_NETWORK__HEATING_CURVE__MIN__3RD=85.0

# Supply temperature of 4th generation heat grid when outdoor temperature is low in degrees Celsius.
# T_HOT_HEATING_NETWORK__HEATING_CURVE__MIN__4TH=65.0

# Supply temperature of 5th generation heat grid when outdoor temperature is low in degrees Celsius.
# T_HOT_HEATING_NETWORK__HEATING_CURVE__MIN__5TH=14.0

# Return temperature of 3rd generation heat grid in degrees Celsius.
# T_COLD_HEATING_NETWORK__CONSTANT__3RD=50.0

# Return temperature of 4th generation heat grid in degrees Celsius.
# T_COLD_HEATING_NETWORK__CONSTANT__4TH=35.0

# Return temperature of 5th generation heat grid in degrees Celsius.
# T_COLD_HEATING_NETWORK__CONSTANT__5TH=11.0

# Return temperature of 3rd generation heat grid when outdoor temperature is high in degrees Celsius.
# T_COLD_HEATING_NETWORK__HEATING_CURVE__MAX__3RD=45.0

# Return temperature of 4th generation heat grid when outdoor temperature is high in degrees Celsius.
# T_COLD_HEATING_NETWORK__HEATING_CURVE__MAX__4TH=30.0

# Return temperature of 5th generation heat grid when outdoor temperature is high in degrees Celsius.
# T_COLD_HEATING_NETWORK__HEATING_CURVE__MAX__5TH=11.0

# Return temperature of 3rd generation heat grid when outdoor temperature is low in degrees Celsius.
# T_COLD_HEATING_NETWORK__HEATING_CURVE__MIN__3RD=50.0

# Return temperature of 4th generation heat grid when outdoor temperature is low in degrees Celsius.
# T_COLD_HEATING_NETWORK__HEATING_CURVE__MIN__4TH=40.0

# Return temperature of 5th generation heat grid when outdoor temperature is low in degrees Celsius.
# T_COLD_HEATING_NETWORK__HEATING_CURVE__MIN__5TH=7.0

# Specific heat capacity of the fluid in J/(kg*K).
# FLUID__C_F=4180.0

# Density of the fluid in kg/m3.
# FLUID__RHO_F=1000.0

# Kinematic viscosity of the fluid in m2/s at 40°C.
# FLUID__NU_F=6.6e-07

# Electric pump efficiency (0 < eta_pump <= 1).
# PUMP__ETA_PUMP=0.65

# Investment costs of the pump in €/kW.
# PUMP__INV_PUMP=700.0

# Pump lifetime in years.
# PUMP__PUMP_LIFETIME=10

# Pump O&M share (fraction of investment cost per year).
# PUMP__COST_OM_PUMP=0.03

# Friction factor (dimensionless). (Initial friction factor for iteration)
# PIPE__F_FRIC=0.025

# Max pressure gradient in Pa/m.
# PIPE__DP_PIPE_MAX=400.0

# Min pressure gradient in Pa/m.
# PIPE__DP_PIPE_MIN=30.0

# Pipe lifetime in years.
# PIPE__PIPE_LIFETIME=30

# Pipe O&M share (fraction of investment cost per year).
# PIPE__COST_OM_PIPE=0.005

##############################################################################
### EHDOConfig
### EHDOConfig class to manage the configuration of the Energy and Heat Distribution Optimization (EHDO) system.
##############################################################################

# Electricity configuration
# Enable electricity supply, bool.
# ENABLE_SUPPLY_EL=True

# Enable feed-in tariff for electricity, bool.
# ENABLE_FEED_IN_EL=True

# Enable electricity capacity price, bool.
# ENABLE_PRICE_CAP_EL=False

# Electricity capacity price in €/kWh.
# PRICE_CAP_EL=60

# Consider capacity of grid connection, bool.
# ENABLE_CAP_LIMIT_EL=False

# in kW   # Capacity of grid connection in kW.
# CAP_LIMIT_EL=100000

# Enable restriction of electricity demand from grid, bool.
# ENABLE_SUPPLY_LIMIT_EL=False

# Restrict electricity demand from grid in MWh/year
# SUPPLY_LIMIT_EL=100000

# Gas configuration
# Enable gas supply, bool.
# ENABLE_SUPPLY_GAS=False

# Enable gas capacity price, bool.
# ENABLE_PRICE_CAP_GAS=False

# Gas capacity price in €/kWh
# PRICE_CAP_GAS=0.04

# Enable natural gas feed-in, bool.
# ENABLE_FEED_IN_GAS=False

# Restrict gas demand from grid, bool.
# ENABLE_CAP_LIMIT_GAS=False

# Maximum annual energy drawn from the gas grid in MWh/year
# CAP_LIMIT_GAS=1000000

# Biomass configuration
# Restrict available biomass, bool.
# ENABLE_SUPPLY_BIOMASS=False

# Enable limit annual biomass import, bool.
# ENABLE_SUPPLY_LIMIT_BIOMASS=False

# Maximum available biomass in MWh/year
# SUPPLY_LIMIT_BIOMASS=1000000

# Hydrogen configuration
# Restrict available hydrogen, bool.
# ENABLE_SUPPLY_HYDROGEN=False

# Enable limit annual hydrogen import, bool.
# ENABLE_SUPPLY_LIMIT_HYDROGEN=False

# Maximum available Hydrogen in MWh/year
# SUPPLY_LIMIT_HYDROGEN=1000000

# Waste configuration
# Restrict available waste, bool.
# ENABLE_SUPPLY_WASTE=False

# Enable limit annual waste import, bool.
# ENABLE_SUPPLY_LIMIT_WASTE=False

# Maximum available waste in MWh/year
# SUPPLY_LIMIT_WASTE=1000000

# Maximum available gas in MWh/year
# SUPPLY_LIMIT_GAS=1000000

# Enable limit annual gas import, bool.
# ENABLE_SUPPLY_LIMIT_GAS=False

# Other options
# Meet peak demands without utilizing fluctuating sources (STC, PV, WT), bool.
# PEAK_DEM_MET_CONV=True

# ! CO₂ emission credit for electricity feed-in kg/kWh (Move to EcoConfig)
# CO2_EL_FEED_IN=0

# ! CO₂ emission credit for gas feed-in kg/kWh (Move to EcoConfig)
# CO2_GAS_FEED_IN=0

# Number of design days.
# N_CLUSTERS=12

# Helper attributes for unit formatting (Remove?)
# used for cases where unit is a placeholder
# UNIT_PLACEHOLDER=" - "

# used for cases where unit is a dash
# UNIT_DASH=-

