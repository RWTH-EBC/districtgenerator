# Initial state of charge.
# D_TES__INIT=0.5

# Maximum temperature difference in degree Celsius.
# D_TES__T_DIFF_MAX=35

# Maximum life time in years.
# D_TES__LIFE_TIME=20

# Unsubsidized investment in €/liter.
# D_TES__INV_BASE=11.0

# Operation and maintenance costs as a fraction of investment costs in 1/year.
