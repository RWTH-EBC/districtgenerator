##############################################################################
### CalendarConfig
### CalendarConfig class to manage calendar-related parameters for the district generator.
##############################################################################

# Consider heating period in the clustering (True) or calculate whole year (False)
# CONSIDER_HEATING_PERIOD=True

# Consider cooling period in the clustering (True) or calculate whole year (False)
# CONSIDER_COOLING_PERIOD=True

# If heating period considered:
# Julian day number of the start of the heating period (default: 15th September)
# HEATING_PERIOD_START=259

# Julian day number of the end of the heating period (default: 15th May)
# HEATING_PERIOD_END=135

# If cooling period considered:
# Julian day number of the start of the cooling period (default: 15th April)
# COOLING_PERIOD_START=105

# Julian day number of the end of the cooling period (default: 1st October)
# COOLING_PERIOD_END=273

##############################################################################
### Scenario
### Scenario class to manage the scenario for the district generator and type of parallelization.
##############################################################################

# default value for scenario name
# SCENARIO_NAME=base_scenario

# default value for parallelization type, options: 'multiprocessing', 'threading'
# PARALLELIZATION=multiprocessing

# Request energy-hub design without a thermal network.
# DESIGN_ENERGY_HUB=False

##############################################################################
### ReportConfig
### ReportConfig class to manage the configuration for report generation in the districtgenerator.
##############################################################################

# Layout
# Alternatives: A3, A4; Layout optimized for A4 Format
# PAGESIZE=A4

# Language
# Language for the report, selected between: "de" (German) and "en" (English).
# LANGUAGE=en

# File format for saving all KPIs, selected between: "xlsx" and "csv".
# KPI_SAVE_TYPE=xlsx

# Main color of the Report, Used for Frames and Lines
# COLORS__PRIMARY_COLOR=#368427

# Secondary color of the report e.g. used for bars in graphs
# COLORS__SECONDARY_COLOR=#86A91A

# Color for the background of the report and for background in tables
# COLORS__BACKGROUND=#FFFFFF

# Color of the text and titles in report
# COLORS__TEXT=#000000

# Color of the text for additional information that is supposed to be less prominent
# COLORS__TEXT_LIGHT=#3C3C3C

# Colors for energy types in graphs
# COLORS__ENERGY__ELECTRICITY=#00551F

# COLORS__ENERGY__HEATING=#86A91A

# COLORS__ENERGY__DHW=#368427

# COLORS__ENERGY__COOLING=#7ABAD6

# COLORS__ENERGY__EV=#663399

# Colors for energy sources and cost categories in graphs
# Grid electricity
# COLORS__SOURCE__ELECTRICITY=#00551F

# Natural gas
# COLORS__SOURCE__GAS=#F39C12

# Heating oil
# COLORS__SOURCE__OIL=#344EFB

# Waste
# COLORS__SOURCE__WASTE=#8B5A2B

# Biomass
# COLORS__SOURCE__BIOMASS=#27AE60

# District heating
# COLORS__SOURCE__DISTRICT_HEAT=#C0392B

# Hydrogen
# COLORS__SOURCE__HYDROGEN=#2980B9

# Waste heat
# COLORS__SOURCE__WASTE_HEAT=#E67E22

# Colors for fixed costs and revenues in financial charts
# Central energy hub fixed costs
# COLORS__SOURCE__EH_FIXED=#2C3E50

# Decentralized fixed costs
# COLORS__SOURCE__DECENTRAL_FIXED=#7F8C8D

# Revenue from electricity feed-in
# COLORS__SOURCE__REVENUE_FEED_IN_EL=#F10F84

# Colors for district layout:
# Color for buildings connected to the heatgrid
# COLORS__LAYOUT__BUILDING_CONNECTED=#2ECC71

# Color for buildings that are not connected to the heatgrid
# COLORS__LAYOUT__BUILDING_NOT_CONNECTED=#95A5A6

# Color for the energy hub
# COLORS__LAYOUT__EH=#E74C3C

# Color for the pipes in the district layout graph
# COLORS__LAYOUT__PIPE=#3498DB

# Radius of the circles representing buildings
# SIZES__BUILDING=7

# Radius of the circle representing the energy hub
# SIZES__EH=10

# Thickness of the lines representing the pipes in the district layout graph
# SIZES__PIPE=5

# Font size for labels in the district layout graph
# SIZES__LABEL=8

# Font size for text in legends in the district layout graph
# SIZES__LEGEND_TEXT=9

# Whether to show the labels for the buildings and the Energy Hub in the district layout graph, bool
# LAYOUT_OPTIONS__SHOW_BUILDING_LABELS=True

# Whether to show labels for the pipes in the district layout graph, bool
# LAYOUT_OPTIONS__SHOW_PIPE_LABELS=True

# FONTS__REGULAR=Helvetica

# FONTS__BOLD=Helvetica-Bold

# Sizes
# FONTS__SIZES__TITLE=20

# FONTS__SIZES__SECTION_TITLE=16

# FONTS__SIZES__SUBSECTION_TITLE=14

# FONTS__SIZES__HIGHLIGHTED=12

# FONTS__SIZES__BODY=12

# FONTS__SIZES__SMALL=10

# FONTS__SIZES__TABLE=11.5

# FONTS__SIZES__AXIS_VALUES=8

# FONTS__SIZES__DENSE=7

# FONTS__SIZES__PAGE_NUMBER=9
