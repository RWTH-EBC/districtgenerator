# This file contains all the default paramters defined in config.py, decentral & central device config
# How to use this file:
# 1. Copy this file to .env.CONFIG or name as you wish -> use the chosen name to load the configuration (see e9)
# 2. Adjust the parameters according to your needs, delete parameters you want to keep default values
# Note: All parameters defined in this file will override the default values in config.py
# Note: Nested parameters (like SOLVER_OPTIONS) need to use double underscores "__" to define the nesting structure
# Example: SOLVER_OPTIONS__TIME_LIMIT=600 -> {"SOLVER_OPTIONS": {"TIME_LIMIT": 600, ...}}

# Keep in mind you need a <scenario_name>.csv file in the data/scenarios folder
SCENARIO_NAME=example

#################################################
### General Configurations (multiple Configs) ###
#################################################

# Location and Climate Data (LocationConfig)
TRYYEAR=TRY2015
TRYTYPE=Jahr
DISTRICT_AREA=1.0
ZIP=52064

# Time and Data Configurations (TimeConfig)
CLUSTERNUMBER=4

# Compact outputs for new batches; existing run snapshots are not changed.
SOLVER_EXPORT_LP=False
SOLVER_EXPORT_TXT=False
SOLVER_EXPORT_COMPACT=True
BATCH_SAVE_DISTRICT_PICKLE=False

# Design Building Parameters (DesignBuildingConfig)
THERMAL_MODEL_TYPE=7R2C

# Economic Parameters (EcoConfig)
NUM_INTERPOLATION_POINTS=3        # Economic support years; enabled policy deadlines are added automatically.
INTERPOLATION_POINTS=0,5,10,15      # (Format: comma separated values -> time series (either [...,...] or ....,...))
INVESTMENT_SENSITIVITY_ENABLED=True  # False -> one mean run; True -> run min, mean, and max cost cases.
INVESTMENT_SENSITIVITY_CASE=mean      # Single-run cost case: min, mean, or max.

