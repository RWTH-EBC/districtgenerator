.env.CONFIG.RURAL# This file contains all the default paramters defined in config.py, decentral & central device config
# How to use this file:
# 1. Copy this file to .env.CONFIG or name as you wish -> use the chosen name to load the configuration (see e9)
# 2. Adjust the parameters according to your needs, delete parameters you want to keep default values
# Note: All parameters defined in this file will override the default values in config.py

# Keep in mind you need a <scenario_name>.csv file in the data/scenarios folder
SCENARIO_NAME=surburban

##########################################################
### Central Device Configuration (CentralDeviceConfig) ###
### Prefix "C_" for central only here, not config.py   ###
##########################################################

#Photovoltaic (PV) Parameters
C_PV_FEASIBLE=true
C_PV_MAX_AREA=18167
C_PV_MIN_AREA=18167

#Heat Pump (HP) Parameters
C_HP_INV_VAR=968
C_HP_LIFE_TIME=25
C_HP_COST_OM=0.03
C_HP_MIN_CAP=0
C_HP_MAX_CAP=100000

#Electric Boiler (EB) Parameters
C_EB_MIN_CAP=0
C_EB_MAX_CAP=500

#Thermal Energy Storage (TES) Parameters
C_TES_FEASIBLE=true
C_TES_INV_VAR=316

#Battery (BAT) Parameters
C_BAT_MIN_CAP=2826
C_BAT_MAX_CAP=2826

